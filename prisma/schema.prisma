generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  location    String
  bedrooms    Int
  bathrooms   Float
  area        Float    // in sq ft
  imageUrl    String
  features    String   // comma separated or JSON string
  galleryImages String?  // JSON array of image paths
  
  // NEW FIELDS
  status        String?
  propertyType  String?
  plotArea      Float?
  transaction   String?
  furnishing    String?
  propertyAge   String?
  
  flatUnitNo    String?
  buildingName  String?
  street        String?
  landmark      String?
  pinCode       String?
  address       String?
  city          String?
  
  youtubeUrl    String?
  isFeatured  Boolean  @default(false)
  isApproved  Boolean  @default(false)
  
  ownerName     String?
  ownerEmail    String?
  ownerPhone    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  propertyNumber   String?  @unique
  assignedClientId String?
  assignedClient   User?    @relation(fields: [assignedClientId], references: [id])
  
  payments    Payment[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER") // USER or ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedProperties Property[]
  payments  Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  propertyId    String
  amount        Float
  status        String   @default("PENDING") // PENDING, COMPLETED, FAILED
  razorpayOrderId String?
  razorpayPaymentId String?
  
  user          User     @relation(fields: [userId], references: [id])
  property      Property @relation(fields: [propertyId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
